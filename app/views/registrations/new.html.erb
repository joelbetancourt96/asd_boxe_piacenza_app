<div class="min-h-[70vh] bg-slate-950 px-4 py-12 text-white sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl overflow-hidden rounded-3xl border border-red-500/20 bg-slate-900/80 shadow-2xl shadow-red-950/40">
    <div class="grid gap-0 lg:grid-cols-2">
      <div class="bg-gradient-to-br from-red-600 via-red-700 to-slate-950 p-8 lg:p-12">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.35em] text-red-100">Boxe Piacenza</p>
        <h1 class="text-4xl font-black tracking-tight text-white">Unisciti alla palestra</h1>
        <p class="mt-5 max-w-md text-base text-red-50/90">
          Crea il tuo account per gestire corsi, riservatezza e accesso ai programmi del club.
        </p>

        <div class="mt-10 space-y-6 text-sm text-red-50/90">
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-base font-bold">1</span>
            <span>Completa i tuoi dati personali</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-base font-bold">2</span>
            <span>Accedi ai corsi del club</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-base font-bold">3</span>
            <span>Monitora progresso e obiettivi</span>
          </div>
        </div>
      </div>

      <div class="p-8 lg:p-12">
        <div class="mb-8">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-red-400">Registrazione</p>
          <h2 class="mt-2 text-3xl font-bold text-white">Crea il tuo account</h2>
        </div>

        <%= form_with model: @user, url: signup_path, class: "space-y-6", local: true do |form| %>
          <% if @user.errors.any? %>
            <div class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-200">
              <p class="font-semibold">Si sono verificati alcuni errori:</p>
              <ul class="mt-2 list-disc space-y-1 pl-5">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form.fields_for :profile do |profile_form| %>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <%= profile_form.label :first_name, "Nome", class: "mb-2 block text-sm font-medium text-slate-200" %>
                <%= profile_form.text_field :first_name, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
              </div>

              <div>
                <%= profile_form.label :last_name, "Cognome", class: "mb-2 block text-sm font-medium text-slate-200" %>
                <%= profile_form.text_field :last_name, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
              </div>
            </div>

            <div class="mt-5">
              <%= profile_form.label :profile_type, "Tipo profilo", class: "mb-2 block text-sm font-medium text-slate-200" %>
              <%= profile_form.select :profile_type,
                    Profile.profile_types.keys.map { |key| [key.humanize, key] },
                    { include_blank: "Seleziona il tipo di profilo" },
                    class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
            </div>
          <% end %>

          <div>
            <%= form.label :email, class: "mb-2 block text-sm font-medium text-slate-200" %>
            <%= form.email_field :email, autofocus: true, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <%= form.label :password, "Password", class: "mb-2 block text-sm font-medium text-slate-200" %>
              <%= form.password_field :password, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
            </div>

            <div>
              <%= form.label :password_confirmation, "Conferma password", class: "mb-2 block text-sm font-medium text-slate-200" %>
              <%= form.password_field :password_confirmation, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
            </div>
          </div>

          <div>
            <%= form.submit "Crea account", class: "w-full cursor-pointer rounded-xl bg-red-600 px-4 py-3 text-base font-bold text-white transition hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
          </div>
        <% end %>

        <p class="mt-6 text-center text-sm text-slate-400">
          Hai già un account?
          <%= link_to "Accedi", login_path, class: "font-semibold text-red-400 hover:text-red-300" %>
        </p>
      </div>
    </div>
  </div>
</div>
