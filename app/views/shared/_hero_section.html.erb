<main class="relative min-h-[100dvh] flex items-center overflow-hidden">
  <div class="absolute inset-0 bg-black/50 z-10"></div>
  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('<%= image_url %>')"></div>

  <div class="relative z-20 mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="max-w-3xl text-left">
      <% if defined?(subtitle) && subtitle.present? %>
        <p class="mb-3 sm:mb-6 text-xs sm:text-sm uppercase tracking-[0.25em] sm:tracking-[0.3em] text-red-400 font-bold"><%= subtitle %></p>
      <% end %>
      <h1 class="mb-4 sm:mb-8 text-4xl font-black tracking-tight text-white sm:text-6xl lg:text-7xl break-words">
        <%= title %>
      </h1>
      <% if defined?(description) && description.present? %>
        <p class="mb-6 sm:mb-10 max-w-2xl text-base sm:text-lg leading-7 sm:leading-8 text-slate-200">
          <%= description %>
        </p>
      <% end %>
      <% if defined?(button_text) && button_text.present? && defined?(button_link) && button_link.present? %>
        <%= link_to button_text, button_link, class: "inline-block text-center rounded-full bg-red-600 px-6 sm:px-8 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-red-500" %>
      <% end %>
    </div>
  </div>
</main>