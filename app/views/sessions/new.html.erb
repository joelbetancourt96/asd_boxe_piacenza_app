<div class="min-h-[70vh] bg-slate-950 px-4 py-12 text-white sm:px-6 lg:px-8">
  <div class="mx-auto max-w-md rounded-3xl border border-slate-800 bg-slate-900/80 p-8 shadow-2xl shadow-red-950/30">
    <div class="mb-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-red-400">Accedi</p>
      <h1 class="mt-3 text-3xl font-black text-white">Bentornato</h1>
    </div>

    <%= form_with url: login_path, method: :post, local: true, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :email, "Email", class: "mb-2 block text-sm font-medium text-slate-200" %>
        <%= form.email_field :email, autofocus: true, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
      </div>

      <div>
        <%= form.label :password, "Password", class: "mb-2 block text-sm font-medium text-slate-200" %>
        <%= form.password_field :password, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-400 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
      </div>

      <div>
        <%= form.submit "Accedi", class: "w-full cursor-pointer rounded-xl bg-red-600 px-4 py-3 text-base font-bold text-white transition hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
      </div>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-400">
      Non hai un account?
      <%= link_to "Registrati", signup_path, class: "font-semibold text-red-400 hover:text-red-300" %>
    </p>
  </div>
</div>
