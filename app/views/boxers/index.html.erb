<%= render "shared/hero_section",
    image_url: asset_path("about_us.jpeg"),
    title: "",
    subtitle: "",
    description: "",
    button_text: "",
    button_link: "" %>

<section id="boxers-section" class="bg-slate-50 py-16 text-black">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h2 class="mb-4 text-4xl font-black tracking-tight text-black">I NOSTRI PUGILI</h2>
      <div class="h-3 w-68 bg-gradient-to-r from-red-600 via-red-500 to-transparent"></div>
    </div>

    <!-- Vue.js Boxers App Mount Point -->
    <div id="boxers-list"></div>
  </div>
</section>

<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script>
  const { createApp } = window.Vue;

  document.addEventListener("DOMContentLoaded", () => {
    const boxersList = document.getElementById("boxers-list");
    if (boxersList) {
      createApp({
        data() {
          return {
            boxers: [],
            searchQuery: "",
            isAdmin: false,
            loading: true,
            error: null
          }
        },
        computed: {
          filteredBoxers() {
            const query = this.searchQuery.trim().toLowerCase();
            if (!query) {
              return this.boxers;
            }

            // Suddivide la ricerca in singole parole per trovare match flessibili
            const queryWords = query.split(/\s+/).filter(Boolean);

            return this.boxers.filter(boxer => {
              const firstName = (boxer.first_name || "").toLowerCase();
              const lastName = (boxer.last_name || "").toLowerCase();
              const fullName = `${firstName} ${lastName}`;
              const reversedFullName = `${lastName} ${firstName}`;

              // Corrisponde se l'intera stringa cercata è presente in "Nome Cognome" o "Cognome Nome",
              // oppure se ogni parola cercata è contenuta nel nome o nel cognome
              const matchesDirect = fullName.includes(query) || reversedFullName.includes(query);
              const matchesAllWords = queryWords.every(word => fullName.includes(word));

              return matchesDirect || matchesAllWords;
            });
          }
        },
        methods: {
          async fetchBoxers() {
            try {
              this.loading = true;
              const response = await fetch("/boxers.json");
              if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
              }

              const payload = await response.json();
              this.isAdmin = Boolean(payload.is_admin);
              this.boxers = payload.boxers || [];
              this.error = null;
            } catch (error) {
              console.error("Error fetching boxers:", error);
              this.error = "Errore nel caricamento dei pugili";
            } finally {
              this.loading = false;
            }
          }
        },
        mounted() {
          this.fetchBoxers();
        },
        template: `
          <!-- Search Bar -->
          <div class="mb-10 max-w-md">
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </span>
              <input 
                type="text" 
                v-model="searchQuery" 
                placeholder="Cerca pugile per nome o cognome..." 
                class="w-full rounded-2xl border border-slate-300 bg-white py-3 pl-11 pr-10 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/20"
              />
              <button 
                v-if="searchQuery" 
                @click="searchQuery = ''" 
                class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600"
                aria-label="Pulisci ricerca"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>
          </div>

          <div v-if="loading" class="text-center py-12">
            <p class="text-xl text-slate-600">Caricamento pugili...</p>
          </div>
          
          <div v-else-if="error" class="text-center py-12">
            <p class="text-xl text-red-600">{{ error }}</p>
          </div>

          <!-- No Results message -->
          <div v-else-if="filteredBoxers.length === 0" class="text-center py-16 bg-white rounded-2xl border border-slate-200">
            <p class="text-lg font-semibold text-slate-700">Nessun pugile trovato</p>
            <p class="text-sm text-slate-500 mt-1">Nessun risultato corrispondente a "{{ searchQuery }}".</p>
          </div>

          <div v-else>
            <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
              <div v-for="boxer in filteredBoxers" :key="boxer.id" class="group overflow-hidden rounded-lg bg-white shadow-md transition hover:shadow-lg">
                <!-- Image Section -->
                <div class="relative aspect-[3/4] overflow-hidden bg-gray-900">
                  <img :src="boxer.image_url" 
                      :alt="boxer.first_name + ' ' + boxer.last_name" 
                      class="h-full w-full object-cover object-top transition group-hover:scale-105">

                  <a
                    v-if="isAdmin"
                    :href="boxer.edit_path"
                    class="absolute right-2 top-12 inline-flex items-center justify-center rounded-full border border-white/80 bg-slate-950/80 p-2 text-red-400 shadow-lg shadow-slate-950/40 transition hover:bg-red-600 hover:text-white"
                    aria-label="Edit boxer"
                    title="Edit boxer"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"/>
                      <path d="M16.5 3.5a2.12 2.12 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/>
                    </svg>
                  </a>

                  <!-- Category Badge (visibile solo se presente) -->
                  <div v-if="boxer.category" class="absolute right-2 top-2 rounded-full bg-[#ee1D23] px-2 py-1 text-xs font-bold uppercase text-white backdrop-blur-sm">
                    {{ boxer.category }}
                  </div>
                  
                  <!-- Nickname Overlay -->
                  <div v-if="boxer.nickname" class="absolute bottom-0 inset-x-0 h-1/4 flex flex-col justify-end bg-gradient-to-t from-black/70 to-black/20 px-4 py-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    <p class="text-xs font-bold uppercase text-[#ee1D23]">Nickname</p>
                    <p class="text-2xl font-black italic text-white">{{ boxer.nickname }}</p>
                  </div>
                </div>

                <!-- Name Section -->
                <div class="bg-[#ee1D23] px-3 py-3 text-white">
                  <p class="text-xs font-semibold">{{ boxer.first_name }}</p>
                  <h3 class="text-lg font-black uppercase text-slate-100">{{ boxer.last_name }}</h3>
                </div>

                <!-- Record Grid (V, P, S) -->
                <div class="grid grid-cols-3 gap-1 bg-white px-3 py-2">
                  <div class="rounded bg-[#ee1D23] px-2 py-2 text-center">
                    <p class="text-xs font-semibold uppercase text-slate-200">V</p>
                    <p class="text-xl font-black text-slate-200">{{ boxer.wins }}</p>
                  </div>
                  <div class="rounded bg-[#ee1D23] px-2 py-2 text-center">
                    <p class="text-xs font-semibold uppercase text-slate-200">P</p>
                    <p class="text-xl font-black text-slate-200">{{ boxer.draws }}</p>
                  </div>
                  <div class="rounded bg-[#ee1D23] px-2 py-2 text-center">
                    <p class="text-xs font-semibold uppercase text-slate-200">S</p>
                    <p class="text-xl font-black text-slate-200">{{ boxer.losses }}</p>
                  </div>
                </div>

                <!-- Bottom Bar (Weight + PRO Tag) -->
                <div class="flex items-center justify-between bg-white px-3 py-2">
                  <div class="flex items-center gap-2 text-xs font-bold text-slate-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
                      <path d="M9 7h6" />
                      <circle cx="8" cy="16" r="1" fill="currentColor" />
                      <circle cx="16" cy="16" r="1" fill="currentColor" />
                    </svg>
                    <span>{{ boxer.weight }} kg</span>
                  </div>
                  <div v-if="boxer.is_pro" class="rounded-full bg-red-600 px-2 py-1 text-xs font-black uppercase text-white">
                    PRO
                  </div>
                </div>                  
              </div>
            </div>
          </div>
        `
      }).mount(boxersList);
    }
  });
</script>