<div class="min-h-[70vh] bg-slate-950 px-4 py-12 text-white sm:px-6 lg:px-8">
  <div class="mx-auto max-w-4xl rounded-3xl border border-slate-800 bg-slate-900/80 p-8 shadow-2xl shadow-red-950/30">
    <div class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-red-400">Modifica pugile</p>
      <h1 class="mt-3 text-3xl font-black text-white"><%= @boxer.first_name %> <%= @boxer.last_name %></h1>
    </div>

    <%= form_with model: @boxer, url: boxer_path(@boxer), method: :patch, local: true, class: "space-y-8" do |form| %>
      <% if @boxer.errors.any? %>
        <div class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-200">
          <ul class="list-disc space-y-1 pl-5">
            <% @boxer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-6 rounded-2xl border border-slate-700 bg-slate-950/70 p-4">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="text-sm font-medium text-slate-300">Foto del pugile</p>
            <% if @boxer.profile_image.attached? %>
              <%= image_tag @boxer.profile_image, class: "mt-3 h-24 w-24 rounded-xl object-cover ring-2 ring-red-500/40" %>
            <% else %>
              <div class="mt-3 flex h-24 w-24 items-center justify-center rounded-xl border border-dashed border-slate-600 bg-slate-900 text-xs text-slate-400">
                Nessuna foto
              </div>
            <% end %>
          </div>

          <div class="w-full md:max-w-md">
            <%= form.label :profile_image, "Carica nuova foto", class: "mb-2 block text-sm font-medium text-slate-200" %>
            <%= form.file_field :profile_image, class: "block w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-200 file:mr-4 file:rounded-full file:border-0 file:bg-red-600 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-red-500" %>
          </div>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :first_name, "Nome", class: "mb-2 block text-sm font-medium text-slate-200" %>
          <%= form.text_field :first_name, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
        </div>

        <div>
          <%= form.label :last_name, "Cognome", class: "mb-2 block text-sm font-medium text-slate-200" %>
          <%= form.text_field :last_name, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
        </div>
      </div>

      <div>
        <%= form.label :profile_type, "Tipo profilo", class: "mb-2 block text-sm font-medium text-slate-200" %>
        <%= form.select :profile_type,
              Profile.profile_types.keys.map { |key| [key.humanize, key] },
              { selected: (@boxer.profile_type.presence || "atleta_agonista") },
              class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
      </div>

      <%= form.fields_for :athlete_detail do |athlete_form| %>
        <div class="grid gap-5 md:grid-cols-2">
          <div>
            <%= athlete_form.label :fpi_card_id, "FPI Card ID", class: "mb-2 block text-sm font-medium text-slate-200" %>
            <%= athlete_form.text_field :fpi_card_id, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
          </div>

          <div>
            <%= athlete_form.label :category, "Categoria", class: "mb-2 block text-sm font-medium text-slate-200" %>
            <%= athlete_form.text_field :category, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
          </div>

          <div>
            <%= athlete_form.label :wins, "Vittorie", class: "mb-2 block text-sm font-medium text-slate-200" %>
            <%= athlete_form.number_field :wins, min: 0, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
          </div>

          <div>
            <%= athlete_form.label :draws, "Pareggi", class: "mb-2 block text-sm font-medium text-slate-200" %>
            <%= athlete_form.number_field :draws, min: 0, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
          </div>

          <div>
            <%= athlete_form.label :losses, "Sconfitte", class: "mb-2 block text-sm font-medium text-slate-200" %>
            <%= athlete_form.number_field :losses, min: 0, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
          </div>

          <div>
            <%= athlete_form.label :weight, "Peso (kg)", class: "mb-2 block text-sm font-medium text-slate-200" %>
            <%= athlete_form.number_field :weight, step: "0.1", min: 0, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
          </div>

          <div>
            <%= athlete_form.label :nickname, "Nickname", class: "mb-2 block text-sm font-medium text-slate-200" %>
            <%= athlete_form.text_field :nickname, class: "w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
          </div>

          <div class="flex items-end">
            <label class="flex w-full items-center justify-between rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-slate-200">
              <span class="text-sm font-medium">Pro</span>
              <%= athlete_form.check_box :is_pro, class: "h-5 w-5 rounded border-slate-600 bg-slate-900 text-red-600 focus:ring-red-500" %>
            </label>
          </div>
        </div>
      <% end %>

      <div class="flex items-center gap-3">
        <%= form.submit "Salva modifiche", class: "cursor-pointer rounded-xl bg-red-600 px-5 py-3 text-base font-bold text-white transition hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/30" %>
        <%= link_to "Annulla", boxers_path, class: "rounded-xl border border-slate-700 px-5 py-3 text-sm font-semibold text-slate-300 transition hover:border-slate-500 hover:text-white" %>
      </div>
    <% end %>
  </div>
</div>
